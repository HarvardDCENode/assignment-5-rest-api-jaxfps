html
    head
        style(type='text/css').
            table {
                width: 100%;
                border-collapse: collapse;
            }
            th, td {
                border: 1px solid black;
                padding: 5px;
                text-align: left;
            }
            th {
                background-color: #f2f2f2;
            }
        style.
            .navigation {
                background-color: #f1f1f1;
                padding: 15px;
                text-align: center;
            }
            .navigation a {
                padding: 10px;
                text-decoration: none;
                color: black;
                display: inline-block;
            }
            .navigation a:hover {
                background-color: #ddd;
            }
    
            
        title Players List
    body
        div(class='navigation')
            a(href='/') Home
            a(href='/listplayers') PlayerList 
            a(href='/addplayer') Add Player

        h1 Players List
        table
            thead
                tr
                    th Player
                    th Team
                    th 
                if players.length > 0
                    for player in players
                        tr
                            td 
                                a(href='/player/'+player.playerName) #{player.playerName}
                            td= player.playerTeam
                            td(width='5%')  
                                a(href='/player/'+player.playerName+'/delete') Delete

                else
                    tr
                        td(colspan='2') No players found
                    
            tbody
                
            