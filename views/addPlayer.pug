html
    head
        style.
            .navigation {
                background-color: #f1f1f1;
                padding: 15px;
                text-align: center;
            }
            .navigation a {
                padding: 10px;
                text-decoration: none;
                color: black;
                display: inline-block;
            }
            .navigation a:hover {
                background-color: #ddd;
            }
        title Add Player
    body
        div(class='navigation')
            a(href='/') Home
            a(href='/listplayers') Player List
            a(href='/addplayer') Add Player
        h1 Add/Edit Player
        form(action="/addplayer", method="POST", id="addPlayerForm")
            div
                table
                    tr
                        td 
                            label(for="playerName") Player Name:
                            input(type="text", id="playerName", name="playerName", required)
                        td
                            label(for="playerTeam") Team: 
                            input(type="text", id="playerTeam", name="playerTeam", required)
            div
                button(type="submit") Submit
        script.
            document.getElementById('addPlayerForm').addEventListener('submit', function() {
                setTimeout(function() {
                    document.getElementById('addPlayerForm').reset();
                }, 100);
            });
